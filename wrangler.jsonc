{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sealproof-pdf-spike",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist/browser-spike",
    "run_worker_first": ["/api/*", "/spike/*"]
  },
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.jpg"],
      "fallthrough": true
    }
  ]
}
