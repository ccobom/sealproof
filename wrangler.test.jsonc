{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // CONTROLLED LIVE TEST ONLY. This file contains no secret values.
  "name": "sealproof-test",
  "main": "src/worker/test-deployment-entry.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "test.sealproof.app",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "./dist/app",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "RELEASE_DB",
      "database_name": "sealproof-test",
      "database_id": "5ab60654-c8a5-425b-83c9-0431eb75fa40",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASE_DOCUMENTS",
      "bucket_name": "sealproof-test-documents"
    }
  ],
  "vars": {
    "DELIVERY_ENABLED": "false",
    "EXPECTED_HOSTNAME": "test.sealproof.app",
    "ACTIVE_WORKFLOW_VERSION": "release-v1",
    "ACTIVE_KEY_VERSION": "pdf-v1",
    "ACTIVE_TICKET_KEY_VERSION": "ticket-v1",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEugZnhz6_XrWjKi",
    "RESEND_FROM": "SealProof Releases <releases@sealproof.app>"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY",
      "KEY_ENCRYPTION_KEY_BASE64",
      "TICKET_ENCRYPTION_KEY_BASE64",
      "RESEND_API_KEY",
      "RESEND_WEBHOOK_SECRET"
    ]
  }
}
